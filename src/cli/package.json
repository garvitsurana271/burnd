{
  "name": "getburnd",
  "version": "0.0.16",
  "description": "Find what's burning a hole in your Claude Code budget. Local-first CLI that reads ~/.claude/projects/*.jsonl, detects 8 cost-leak patterns (retry storms, model overuse, repeated reads, etc.), and shows dollar values + fixes. Demo: https://youtu.be/izctEOJBids",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "cost",
    "cost-analysis",
    "cost-optimization",
    "analytics",
    "developer-tools",
    "cli",
    "local-first"
  ],
  "homepage": "https://getburnd.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garvitsurana271/burnd.git",
    "directory": "src/cli"
  },
  "bugs": {
    "url": "https://github.com/garvitsurana271/burnd/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Garvit Surana",
    "email": "garvitsurana10@gmail.com",
    "url": "https://getburnd.vercel.app"
  },
  "type": "module",
  "bin": {
    "burnd": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./lib": {
      "import": "./dist/lib.js",
      "types": "./dist/lib.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
